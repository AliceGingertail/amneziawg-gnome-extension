msgstr "В конфигурации некорректный адрес или порт сервера"

#: tunnelConfig.js:118
msgid "The saved configuration has no valid DNS servers"
msgstr "В сохранённой конфигурации отсутствуют корректные DNS-серверы"

#: tunnelConfig.js:125
msgid "The configuration is missing AllowedIPs"
msgstr "В конфигурации отсутствует список AllowedIPs"

#: tunnelConfig.js:128
