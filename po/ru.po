#: amneziaService.js:38
msgid "The Amnezia service is not responding"
msgstr "Служба Amnezia не отвечает"

#: amneziaService.js:59 vpnController.js:151
msgid "The Amnezia service is unavailable"
msgstr "Служба Amnezia недоступна"

#: amneziaService.js:66
msgid "Not connected to the Amnezia service"
msgstr "Нет соединения со службой Amnezia"

#: amneziaService.js:87
msgid "Failed to send a command to the Amnezia service"
msgstr "Ошибка отправки команды службе Amnezia"

#: amneziaService.js:100
msgid "The service connection was closed"
msgstr "Соединение со службой закрыто"

#: amneziaService.js:106
msgid "The service response is too large"
msgstr "Ответ службы слишком большой"

#: amneziaService.js:114
msgid "Invalid service response"
msgstr "Некорректный ответ службы"

#: amneziaService.js:122
msgid "Failed to read the Amnezia service status"
msgstr "Ошибка чтения состояния службы Amnezia"

#: amneziaService.js:130
msgid "Invalid service status"
msgstr "Некорректное состояние службы"

#: amneziaService.js:155
msgid "The service failed to connect the VPN"
msgstr "Служба не смогла подключить VPN"

#: amneziaService.js:159
msgid "The service reported a VPN error"
msgstr "Служба сообщила об ошибке VPN"

#: amneziaService.js:160
msgid "VPN error in the Amnezia service"
msgstr "Ошибка VPN в службе Amnezia"

#: amneziaService.js:167
msgid "The service status is not yet known"
msgstr "Состояние службы пока неизвестно"

#: amneziaService.js:169
msgid "Wait for the previous command to finish"
msgstr "Дождитесь завершения предыдущей команды"

#: amneziaService.js:171
msgid "Unknown VPN command"
msgstr "Неизвестная команда VPN"

#: amneziaService.js:178
msgid ""
"The Amnezia service did not confirm VPN connection: no matching handshake "
"event"
msgstr ""
"Служба Amnezia не подтвердила подключение VPN: не получено событие handshake "
"для выбранного сервера"

#: amneziaService.js:179
msgid "The Amnezia service did not confirm VPN disconnection"
msgstr "Служба Amnezia не подтвердила отключение VPN"

#: amneziaService.js:217
msgid "Connection to the Amnezia service was lost"
msgstr "Соединение со службой Amnezia потеряно"

#: amneziaService.js:268
msgid "The Amnezia service response timed out"
msgstr "Служба Amnezia не ответила вовремя"

#: amneziaService.js:289
msgid "The Amnezia service closed the connection"
msgstr "Служба Amnezia закрыла соединение"

#: amneziaService.js:295
msgid "The Amnezia service response is too large"
msgstr "Слишком большой ответ службы Amnezia"

#: amneziaService.js:303
msgid "Invalid response from the Amnezia service"
msgstr "Некорректный ответ службы Amnezia"

#: amneziaService.js:309
msgid "The service response is missing the VPN status"
msgstr "В ответе службы отсутствует состояние VPN"

#: amneziaService.js:330
msgid "Failed to send a request to the Amnezia service"
msgstr "Не удалось отправить запрос службе Amnezia"

#: amneziaService.js:334
msgid "Failed to connect to the Amnezia service"
msgstr "Не удалось подключиться к службе Amnezia"

#: extension.js:48
msgid "Amnezia"
msgstr "Amnezia"

#: extension.js:72 extension.js:73
