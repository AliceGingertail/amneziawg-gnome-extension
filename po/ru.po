msgid "Invalid escape sequence in Qt settings"
msgstr "Некорректное экранирование настроек Qt"

#: qtSettings.js:48
msgid "Unsupported escape sequence in Qt settings"
msgstr "Неподдерживаемое экранирование настроек Qt"

