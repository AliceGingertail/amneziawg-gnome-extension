msgid "The configuration file is accessible"
msgstr "Файл конфигурации доступен"

#: prefs.js:38
msgid "File not found or unreadable"
msgstr "Файл не найден или недоступен для чтения"

#: prefs.js:44 prefs.js:46
msgid "Failed to check the configuration file"
msgstr "Не удалось проверить файл конфигурации"

#: prefs.js:49
msgid "Select a configuration file"
msgstr "Выбрать файл конфигурации"

#: prefs.js:52
msgid "Select AmneziaVPN.conf"
msgstr "Выбрать AmneziaVPN.conf"

#: prefs.js:63
msgid "Failed to select a file"
msgstr "Не удалось выбрать файл"

#: prefs.js:68
msgid "Network interface"
msgstr "Сетевой интерфейс"

#: prefs.js:69
msgid "Interface used to monitor VPN status"
msgstr "Интерфейс для отслеживания состояния VPN"

#: prefs.js:88
#, javascript-format
msgid "Failed to list network interfaces: %s"
msgstr "Не удалось получить список сетевых интерфейсов: %s"

#: prefs.js:95
msgid "Automatic"
msgstr "Автоматически"

#: prefs.js:105
msgid "Refresh the interface list"
msgstr "Обновить список интерфейсов"

#: prefs.js:109
msgid "Experimental"
msgstr "Тестовые функции"

#: prefs.js:110
msgid "Test features. Reconnection does not provide leak protection."
msgstr "Тестовые функции. Переподключение не защищает от утечек."

#: prefs.js:112
msgid "Reconnect after suspend (experimental)"
msgstr "Переподключаться после сна (тестовая функция)"

#: prefs.js:113
msgid ""
"Reconnect the previously active server after wake. IP and DNS traffic may "
"bypass the VPN while reconnecting."
msgstr ""
"После пробуждения переподключать ранее активный сервер. Во время "
"переподключения IP- и DNS-трафик может идти в обход VPN."

#: prefs.js:117
msgid "Appearance"
msgstr "Внешний вид"

#: prefs.js:118
msgid ""
"Light or dark icons are selected automatically based on the Shell theme."
msgstr ""
"Светлый или тёмный вариант иконок выбирается автоматически по теме Shell."

#: prefs.js:121
msgid "Top bar icon"
msgstr "Иконка в верхней панели"

#: prefs.js:122
msgid "Standard"
msgstr "Обычная"

#: prefs.js:122
msgid "Colored"
msgstr "Цветная"

